import { remote } from "webdriverio";
import fs from "fs";

const UDID = process.env.UDID;
const BUNDLE = process.env.BUNDLE_ID || "app.rork.ai-bible-explorer";
const SHOTS = process.env.SHOTS_DIR || "shots";
fs.mkdirSync(SHOTS, { recursive: true });

let n = 1;
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const log = (...a) => console.log("[e2e]", ...a);

async function shot(driver, name) {
  try {
    const b64 = await driver.takeScreenshot();
    const file = `${SHOTS}/${String(n).padStart(2, "0")}-${name}.png`;
    fs.writeFileSync(file, Buffer.from(b64, "base64"));
    log("shot", file);
    n++;
  } catch (e) {
    log("shot-failed", name, e.message);
  }
}

const byText = (t) => `-ios predicate string:label == "${t}" OR name == "${t}" OR value == "${t}"`;
const byContains = (t) => `-ios predicate string:label CONTAINS "${t}" OR name CONTAINS "${t}" OR value CONTAINS "${t}"`;
const byField = (placeholder) =>
  `-ios predicate string:(type == "XCUIElementTypeTextField" OR type == "XCUIElementTypeSecureTextField") AND (value == "${placeholder}" OR name == "${placeholder}" OR label == "${placeholder}")`;

async function tap(driver, selector, label, timeout = 15000) {
  try {
    const el = await driver.$(selector);
    await el.waitForExist({ timeout });
    await el.click();
    log("tapped", label);
    return true;
  } catch (e) {
    log("tap-failed", label, e.message.split("\n")[0]);
    return false;
  }
}

async function typeInto(driver, placeholder, text) {
  try {
    const el = await driver.$(byField(placeholder));
    await el.waitForExist({ timeout: 12000 });
    await el.click();
    await el.setValue(text);
    log("typed into", placeholder);
    return true;
  } catch (e) {
    log("type-failed", placeholder, e.message.split("\n")[0]);
    return false;
  }
}

// Registration fields: locate by testID (immune to placeholder-vs-value matching
// once a field has content) and VERIFY the value actually landed — CI simulators
// occasionally swallow typeText into secure fields (strong-password overlay).
async function typeIntoId(driver, testId, text, { secure = false } = {}) {
  for (let attempt = 1; attempt <= 3; attempt++) {
    try {
      const el = await driver.$(`~${testId}`);
      await el.waitForExist({ timeout: 12000 });
      await el.click();
      await sleep(400);
      if (attempt > 1) { try { await el.clearValue(); } catch {} }
      await el.setValue(text);
      const val = (await el.getAttribute("value")) || "";
      // Secure fields report bullets; either way the length must match what we sent.
      const landed = secure ? val.length >= text.length : val === text || val.length >= text.length;
      if (landed) {
        log("typed into", testId, attempt > 1 ? `(attempt ${attempt})` : "");
        return true;
      }
      log("type-verify-miss", testId, `attempt ${attempt}, value len ${val.length}`);
    } catch (e) {
      log("type-error", testId, `attempt ${attempt}:`, e.message.split("\n")[0]);
    }
    await sleep(800);
  }
  log("type-failed", testId, "after 3 verified attempts");
  return false;
}

// Detect a native iOS alert (e.g. "Registration Failed") and read its text.
async function alertInfo(driver) {
  try {
    const a = await driver.$('-ios predicate string:type == "XCUIElementTypeAlert"');
    if (!(await a.isExisting())) return { present: false, text: "" };
    const parts = [];
    try {
      const labels = await a.$$('-ios predicate string:type == "XCUIElementTypeStaticText"');
      for (const l of labels) { try { parts.push(await l.getText()); } catch {} }
    } catch {}
    return { present: true, text: parts.join(" | ") };
  } catch {
    return { present: false, text: "" };
  }
}

const caps = {
  platformName: "iOS",
  "appium:automationName": "XCUITest",
  "appium:udid": UDID,
  "appium:bundleId": BUNDLE,
  "appium:newCommandTimeout": 300,
  "appium:wdaLaunchTimeout": 240000,
  "appium:wdaConnectionTimeout": 240000,
};

// WebDriverAgent's first build on a cold simulator can exceed the HTTP client's
// header timeout (UND_ERR_HEADERS_TIMEOUT on POST /session). Retry session
// creation a few times — the 2nd attempt usually finds WDA already built/cached.
async function createSession(attempts = 3) {
  for (let i = 1; i <= attempts; i++) {
    try {
      return await remote({
        hostname: "127.0.0.1",
        port: 4723,
        path: "/",
        capabilities: caps,
        logLevel: "error",
        connectionRetryTimeout: 300000,
      });
    } catch (e) {
      log(`session attempt ${i}/${attempts} failed:`, (e.message || "").split("\n")[0]);
      if (i === attempts) throw e;
      await sleep(8000);
    }
  }
}

const driver = await createSession();

try {
  await sleep(8000);
  await shot(driver, "onboarding");

  // Onboarding -> walk all slides -> goal picker (1.3) -> login.
  // Fallback to Skip if the flow changes.
  let reachedGoalStep = false;
  for (let i = 0; i < 3; i++) {
    if (!(await tap(driver, byText("Continue"), `Continue ${i + 1}`, 6000))) break;
    await sleep(1200);
  }
  if (await tap(driver, byContains("Get Started"), "Get Started", 6000)) {
    await sleep(1500);
    await shot(driver, "goal-picker");
    if (await tap(driver, "~goal-habit", "goal: build a daily habit", 8000)) {
      reachedGoalStep = true;
      log("GOAL-PICKER RESULT: PASS — goal step shown and selectable");
    } else {
      log("GOAL-PICKER RESULT: FAIL — goal cards not found after Get Started");
    }
  }
  if (!reachedGoalStep) {
    await tap(driver, byText("Skip"), "Skip (fallback)");
  }
  await sleep(2500);
  await shot(driver, "login");

  // Login -> Create Account
  await tap(driver, byContains("Create Account"), "Create Account link");
  await sleep(2000);
  await shot(driver, "register");

  // Fill registration with a unique email
  const email = `e2e_${Date.now()}@scripturemate.test`;
  await typeIntoId(driver, "register-name", "Grace Bennett");
  await typeIntoId(driver, "register-email", email);
  await typeIntoId(driver, "register-password", "ScriptureQA2026!", { secure: true });
  await typeIntoId(driver, "register-confirm", "ScriptureQA2026!", { secure: true });
  await shot(driver, "register-filled");
  try { await driver.execute("mobile: hideKeyboard"); } catch {}

  // DOUBLE-SUBMIT TEST: rapidly tap "Create Account" twice. Pre-fix this raced two
  // concurrent signUp calls; the loser hit the auth.users email-unique constraint
  // and GoTrue returned "Database error saving new user" as an alert even though
  // the account was created. With the submittingRef guard the 2nd tap is a no-op
  // and registration completes cleanly with no alert.
  try {
    const submit = await driver.$("~register-submit");
    await submit.waitForExist({ timeout: 10000 });
    await submit.click();
    await submit.click();
    log("double-tapped Create Account (register-submit)");
  } catch (e) {
    log("double-tap failed, single-tap fallback:", (e.message || "").split("\n")[0]);
    await tap(driver, byContains("Create Account"), "Create Account submit");
  }
  await sleep(9000);
  await shot(driver, "after-double-submit");

  // Assert: no scary error alert. This is the core regression check.
  const alert = await alertInfo(driver);
  if (alert.present) {
    log("DOUBLE-SUBMIT RESULT: FAIL — alert present ->", alert.text);
    await tap(driver, byText("OK"), "dismiss alert", 4000); // dismiss so the run can continue
  } else {
    log("DOUBLE-SUBMIT RESULT: PASS — no error alert after double-tap");
  }
  await sleep(1500);
  await shot(driver, "home");

  // Home -> Ask AI about this verse
  await tap(driver, byContains("Ask AI about this verse"), "Ask AI about this verse");
  await sleep(3500);
  await shot(driver, "ai-screen");

  // Send a verse-specific prompt and wait for the grounded answer
  await tap(driver, byContains("Explain this verse"), "Explain this verse");
  log("waiting for AI response...");
  await sleep(15000);
  await shot(driver, "ai-thinking");
  await sleep(20000);
  await shot(driver, "ai-response");

  // --- Marketing captures: clean home + Bible reader ---
  // Tab-bar buttons aren't matchable by visible text, so tap them by coordinate.
  const { width, height } = await driver.getWindowSize();
  const tabY = Math.round(height - 40);
  const tabX = (i) => Math.round((width * (i + 0.5)) / 5);
  async function tapXY(x, y, label) {
    try {
      await driver.execute("mobile: tap", { x, y });
      log("tapXY", label, x, y);
      return true;
    } catch (e) {
      try {
        await driver.action("pointer").move({ x, y }).down().pause(60).up().perform();
        log("tapXY(action)", label, x, y);
        return true;
      } catch (e2) {
        log("tapXY-failed", label, (e2.message || "").split("\n")[0]);
        return false;
      }
    }
  }

  // Home tab -> clean home hero shot
  await tapXY(tabX(0), tabY, "Home tab");
  await sleep(2500);
  await shot(driver, "home-clean");

  // Open the Bible reader via the "Read Bible" quick action (fallback: Bible tab by coord)
  if (!(await tap(driver, byContains("Read Bible"), "Read Bible quick action", 8000))) {
    await tapXY(tabX(1), tabY, "Bible tab");
  }
  await sleep(2500);
  await shot(driver, "bible-books");
  // testID beats text here: "Psalms" also matches Home's "Psalms of Comfort"
  // plan card since tab screens stay mounted in the element tree.
  if (await tap(driver, "~book-19", "Psalms book", 8000)) {
    await sleep(2000);
    await shot(driver, "bible-chapters");
    if (!(await tap(driver, "~chapter-23", "Psalm 23", 5000))) {
      await tap(driver, "~chapter-1", "Psalm 1", 5000);
    }
    await sleep(2500);
    await shot(driver, "bible-reader");
  }

  // Verse study panel (1.3): tap verse 1 → commentary card with
  // cross-references, Strong's original-language words, and the Matthew
  // Henry commentary section (1.3.x deep-study pack).
  if (await tap(driver, "~verse-1", "verse 1", 8000)) {
    await sleep(3000);
    const xrefs = await driver.$("~cross-refs");
    const strongs = await driver.$("~strongs-words");
    const mh = await driver.$("~mh-commentary");
    const xr = await xrefs.isExisting();
    const st = await strongs.isExisting();
    const mc = await mh.isExisting();
    log(`VERSE-PANEL RESULT: ${xr && st && mc ? "PASS" : "FAIL"} — cross-refs=${xr} strongs=${st} commentary=${mc}`);
    await shot(driver, "verse-study-panel");

    // Word study (1.3.x): tap the first Strong's row → word screen with the
    // lemma hero and (free tier) the Study upsell.
    const wordRow = await driver.$('-ios predicate string:name BEGINSWITH "strongs-word-"');
    if (await wordRow.isExisting()) {
      await wordRow.click();
      await sleep(2500);
      const upsell = await driver.$("~word-upgrade");
      const occ = await driver.$("~word-occurrences");
      const ok = (await upsell.isExisting()) || (await occ.isExisting());
      log(`WORD-STUDY RESULT: ${ok ? "PASS" : "FAIL"} — word screen rendered`);
      await shot(driver, "word-study");
      await tap(driver, "~word-back", "word back", 6000);
      await sleep(1500);
    } else {
      log("WORD-STUDY RESULT: FAIL — no tappable Strong's row");
      await tap(driver, "~verse-1", "close verse panel", 5000);
      await sleep(1000);
    }
  }

  // Offline full-text verse search (1.3): search "shepherd" and expect a
  // Psalms 23 hit from the bundled corpus.
  if (await tap(driver, "~bible-search-toggle", "search toggle", 6000)) {
    await typeInto(driver, "Search a verse, book, or topic…", "refuge and strength");
    await sleep(2500);
    const hit = await driver.$(byContains("Psalms 46"));
    if (await hit.isExisting()) {
      log("VERSE-SEARCH RESULT: PASS — offline corpus hit for 'refuge and strength'");
    } else {
      log("VERSE-SEARCH RESULT: FAIL — no Psalms 46 hit");
    }
    await shot(driver, "verse-search");
    await tap(driver, "~bible-search-toggle", "close search", 5000);
    await sleep(1000);
  }

  // Audio toggle smoke check must run while still in the reader (it only
  // exists there), before the read-chapter check backs out to the grid.
  if (await tap(driver, "~toggle-audio", "audio toggle", 5000)) {
    await sleep(1500);
    await shot(driver, "audio-bar");
    // Audio 2.0: start narrated playback, confirm the persistent mini-player
    // appears (it floats above the tab bar), then stop it so later steps run
    // in silence.
    if (await tap(driver, "~audio-narrated", "narrated play", 6000)) {
      await sleep(4000);
      const mini = await driver.$("~audio-mini-player");
      if (await mini.isExisting()) {
        log("AUDIO-MINIPLAYER RESULT: PASS — mini-player mounted during narrated playback");
      } else {
        log("AUDIO-MINIPLAYER RESULT: FAIL — no mini-player while narrated audio active");
      }
      await shot(driver, "audio-miniplayer");
      await tap(driver, "~mini-close", "stop narrated audio", 5000);
      await sleep(1000);
    } else {
      log("AUDIO-MINIPLAYER RESULT: SKIP — narrated row not tappable");
    }
    // close the audio bar so it doesn't cover the reader
    await tap(driver, "~toggle-audio", "audio toggle off", 5000);
    await sleep(800);
  }

  // --- 1.2.2 feature checks: read-chapter indicators + AI back navigation ---
  // Back out of the reader to the chapter grid: the just-read chapter must now
  // be marked read ("N of M chapters read" progress line + tinted cell).
  if (await tap(driver, "~bible-back", "reader back", 8000)) {
    await sleep(2000);
    const progress = await driver.$(byContains("chapters read"));
    if (await progress.isExisting()) {
      log("READ-CHAPTER RESULT: PASS — progress line present in chapter grid");
    } else {
      log("READ-CHAPTER RESULT: FAIL — no 'chapters read' progress line after reading");
    }
    await shot(driver, "chapters-read-indicator");

    // Reading Journey (1.3): back to the books list, open the journey card,
    // assert the progress hero + milestones render.
    if (await tap(driver, "~bible-back", "back to books", 8000)) {
      await sleep(1500);
      if (await tap(driver, "~journey-card", "journey card", 8000)) {
        await sleep(2000);
        const ms = await driver.$(byContains("Milestones"));
        if (await ms.isExisting()) {
          log("JOURNEY RESULT: PASS — journey screen renders with milestones");
        } else {
          log("JOURNEY RESULT: FAIL — milestones section missing");
        }
        await shot(driver, "reading-journey");
        await tap(driver, "~journey-back", "journey back", 5000);
        await sleep(1200);
      } else {
        log("JOURNEY RESULT: FAIL — journey card not found in books view");
      }
    }
  }

  // Smarter Continue Reading (1.3): Home should suggest the next unread
  // chapter ("Up next") since Psalm 23 was just read.
  await tapXY(tabX(0), tabY, "Home tab");
  await sleep(2000);
  const upNext = await driver.$(byContains("Up next"));
  if (await upNext.isExisting()) {
    log("CONTINUE-READING RESULT: PASS — 'Up next' suggestion on Home");
  } else {
    log("CONTINUE-READING RESULT: FAIL — no 'Up next' on Home");
  }
  await shot(driver, "home-up-next");

  // Goal-personalized plan card (1.3): shown when a goal was picked in
  // onboarding and its starter plan hasn't been started yet.
  const goalCard = await driver.$("~goal-plan-card");
  if (await goalCard.isExisting()) {
    log("GOAL-CARD RESULT: PASS — 'Picked for you' plan card on Home");
    await shot(driver, "home-goal-card");
  } else {
    log("GOAL-CARD RESULT: " + (reachedGoalStep ? "FAIL — goal picked but no card" : "SKIP — goal step not reached"));
  }

  // Morning & Evening devotional (1.3): Home card opens the Spurgeon reading
  // with a linkable key verse.
  if (await tap(driver, "~devotional-card", "Morning & Evening card", 8000)) {
    await sleep(2500);
    const verseChip = await driver.$("~devotional-verse");
    if (await verseChip.isExisting()) {
      log("DEVOTIONAL RESULT: PASS — reading + verse chip rendered");
    } else {
      log("DEVOTIONAL RESULT: FAIL — devotional screen missing verse chip");
    }
    await shot(driver, "devotional");
    await tap(driver, "~devotional-back", "devotional back", 6000);
    await sleep(1500);
  } else {
    log("DEVOTIONAL RESULT: FAIL — no devotional card on Home");
  }

  // AI back navigation: push to the AI tab from Home, then use the new header
  // back button (testID ai-back) to return. Pre-fix there was no way back.
  await tapXY(tabX(0), tabY, "Home tab");
  await sleep(2000);
  if (await tap(driver, byContains("AI Guide"), "AI Guide quick action", 8000)) {
    await sleep(2500);
    await shot(driver, "ai-with-back");
    if (await tap(driver, "~ai-back", "AI back button", 8000)) {
      await sleep(2000);
      const home = await driver.$(byContains("Quick Actions"));
      if (await home.isExisting()) {
        log("AI-BACK RESULT: PASS — back button returned to Home");
      } else {
        log("AI-BACK RESULT: FAIL — did not land on Home after ai-back");
      }
      await shot(driver, "after-ai-back");
    } else {
      log("AI-BACK RESULT: FAIL — ai-back button not found on AI screen");
    }
  }

  // --- New-feature smoke checks (Wave 1/3) ---
  await tapXY(tabX(0), tabY, "Home tab");
  await sleep(2500);
  if (await tap(driver, "~home-streak", "streak chip", 6000)) {
    await sleep(2000);
    await shot(driver, "achievements");
    await tap(driver, "~achievements-back", "achievements back", 5000);
    await sleep(1200);
  }
  if (await tap(driver, "~action-prayer", "prayer action", 6000)) {
    await sleep(2000);
    await shot(driver, "prayer");
  }

  log("walkthrough complete");
} catch (e) {
  log("FATAL", e.message);
  await shot(driver, "error");
} finally {
  try { await driver.deleteSession(); } catch {}
}
